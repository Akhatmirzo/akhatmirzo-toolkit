  "keywords": [
    "cli",
    "react",
    "ui",
    "components",
    "blocks",
    "tailwind",
    "akhatmirzo"
  ],
  "license": "MIT",
  "author": {
    "name": "Akhatmirzo Umarov",
    "url": "https://akhatmirzo.uz"
  },
  "homepage": "https://toolkit.akhatmirzo.uz/uz/docs/v0.4/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhatmirzo/akhatmirzo-toolkit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Akhatmirzo/akhatmirzo-toolkit/issues"
  },
  "type": "module",
  "bin": {
    "akhatmirzo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
