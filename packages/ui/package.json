{
  "name": "@akhatmirzo/ui",
  "version": "0.4.0",
  "description": "Accessible React UI components built on Tailwind CSS v4 and Radix UI: forms, overlays, DataTable, DatePicker, dark mode and Uzbek-ready inputs (phone, card, so'm).",
  "keywords": [
    "react",
    "react-components",
    "ui",
    "ui-library",
    "components",
    "component-library",
    "tailwind",
    "tailwindcss",
    "tailwind-v4",
    "radix",
    "radix-ui",
    "design-system",
    "typescript",
    "accessible",
    "a11y",
    "dark-mode",
    "headless",
    "forms",
    "datatable",
    "datepicker",
    "uzbek",
    "uzbekistan"
  ],
  "license": "MIT",
  "author": {
    "name": "Akhatmirzo Umarov",
    "url": "https://akhatmirzo.uz"
  },
  "homepage": "https://toolkit.akhatmirzo.uz/uz/docs/v0.4/introduction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhatmirzo/akhatmirzo-toolkit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Akhatmirzo/akhatmirzo-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "source": "./src/charts/index.ts",
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./form": {
      "source": "./src/form/index.ts",
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@akhatmirzo/tokens": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18",
    "recharts": "^3.0.0",
    "react-hook-form": "^7.50.0"
  },
  "dependencies": {
    "@akhatmirzo/core": "workspace:^",
    "@akhatmirzo/hooks": "workspace:^",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@akhatmirzo/tokens": "workspace:^",
    "@hookform/resolvers": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./charts": {
        "types": "./dist/charts/index.d.ts",
        "import": "./dist/charts/index.js"
      },
      "./form": {
        "types": "./dist/form/index.d.ts",
        "import": "./dist/form/index.js"
      }
    }
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  }
}
