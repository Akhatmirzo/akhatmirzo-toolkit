{
  "name": "@akhatmirzo/ui",
  "version": "0.1.1",
  "description": "Tailwind v4 va Radix asosidagi React komponentlar",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "radix-ui",
    "design-system",
    "uzbek"
  ],
  "license": "MIT",
  "author": "Akhatmirzo",
  "homepage": "https://toolkit.akhatmirzo.uz/uz/docs/v0.1/introduction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhatmirzo/akhatmirzo-toolkit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Akhatmirzo/akhatmirzo-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@akhatmirzo/tokens": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@akhatmirzo/core": "workspace:^",
    "@akhatmirzo/hooks": "workspace:^",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@akhatmirzo/tokens": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
