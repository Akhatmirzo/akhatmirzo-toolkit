{
  "name": "@akhatmirzo/core",
  "version": "0.2.0",
  "description": "Dependency-free TypeScript utilities: formatting (phone, money, dates), validation (phone, card, email), Latin-Cyrillic transliteration, storage and API helpers for Uzbek apps.",
  "keywords": [
    "typescript",
    "utils",
    "utilities",
    "formatting",
    "format",
    "validation",
    "validate",
    "transliteration",
    "latin",
    "cyrillic",
    "phone",
    "currency",
    "money",
    "storage",
    "fetch",
    "uzbek",
    "uzbekistan",
    "tree-shakeable"
  ],
  "license": "MIT",
  "author": {
    "name": "Akhatmirzo Umarov",
    "url": "https://akhatmirzo.uz"
  },
  "homepage": "https://toolkit.akhatmirzo.uz/uz/docs/v0.1/core/text",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhatmirzo/akhatmirzo-toolkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Akhatmirzo/akhatmirzo-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
