{
  "name": "@akhatmirzo/hooks",
  "version": "0.1.3",
  "description": "Small, SSR-safe React hooks in TypeScript: useDebounce, useLocalStorage, useMediaQuery, useHotkeys, useAsync, usePagination and more.",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "typescript",
    "ssr",
    "use-debounce",
    "use-local-storage",
    "use-media-query",
    "use-hotkeys",
    "use-click-outside",
    "use-async",
    "pagination",
    "tree-shakeable"
  ],
  "license": "MIT",
  "author": {
    "name": "Akhatmirzo Umarov",
    "url": "https://akhatmirzo.uz"
  },
  "homepage": "https://toolkit.akhatmirzo.uz/uz/docs/v0.1/hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akhatmirzo/akhatmirzo-toolkit.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/Akhatmirzo/akhatmirzo-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
