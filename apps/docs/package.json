{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "demos": "node scripts/generate-demos.mjs",
    "registry": "node scripts/generate-registry.mjs",
    "dev": "node scripts/generate-demos.mjs && node scripts/generate-registry.mjs && next dev --port 3000",
    "build": "node scripts/generate-demos.mjs && node scripts/generate-registry.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "node scripts/generate-demos.mjs && next typegen && tsc --noEmit",
    "docs:version": "node scripts/new-version.mjs"
  },
  "dependencies": {
    "@akhatmirzo/core": "workspace:^",
    "@akhatmirzo/hooks": "workspace:^",
    "@akhatmirzo/tokens": "workspace:^",
    "@akhatmirzo/ui": "workspace:^",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
